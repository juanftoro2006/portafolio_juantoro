---
// Página individual de cada proyecto. Renderiza el cuerpo markdown completo
// (el case study largo) más los metadatos estructurados del schema.
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const proyectos = await getCollection("proyectos");
	return proyectos.map((proyecto) => ({
		params: { id: proyecto.id },
		props: { proyecto },
	}));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
---

<Layout titulo={`${proyecto.data.titulo} — Juan Toro`}>
	<main class="mx-auto max-w-3xl px-4 py-12">
		<a href="/" class="text-sm text-blue-600 hover:underline">← volver</a>
		<h1 class="text-3xl font-bold mt-4">{proyecto.data.titulo}</h1>
		{proyecto.data.cliente_anonimizado && (
			<p class="text-slate-500">Cliente: {proyecto.data.cliente_anonimizado}</p>
		)}

		<section class="mt-6">
			<h2 class="text-xl font-semibold">Problema</h2>
			<p>{proyecto.data.problema}</p>
		</section>

		<section class="mt-6">
			<h2 class="text-xl font-semibold">Solución</h2>
			<p>{proyecto.data.solucion}</p>
		</section>

		{proyecto.data.resultado && (
			<section class="mt-6">
				<h2 class="text-xl font-semibold">Resultado</h2>
				<p>{proyecto.data.resultado}</p>
			</section>
		)}

		{proyecto.data.snippet_codigo && (
			<section class="mt-6">
				<h2 class="text-xl font-semibold">Snippet</h2>
				<p class="text-slate-500 text-sm">{proyecto.data.snippet_descripcion}</p>
				<pre class="bg-slate-900 text-slate-100 p-4 rounded overflow-x-auto"><code>{proyecto.data.snippet_codigo}</code></pre>
			</section>
		)}

		<article class="mt-8 prose">
			<Content />
		</article>
	</main>
</Layout>
